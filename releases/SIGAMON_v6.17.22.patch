+# -*- coding: utf-8 -*-
+"""Pure resolver and topology rules for SIGAMON Underbuild.
+
+The module deliberately has no QGIS imports.  ``plugin.py`` converts layer
+features to dictionaries and this module decides which records belong to the
+selected project/location/stage before any geometry or mutation is attempted.
+"""
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+import heapq
+import math
+import re
+
+import stage_model
+
+
+def clean(value):
+    """Return a stable comparison string without null-like placeholders."""
+    try:
+        text = re.sub(r"\s+", " ", str(value if value is not None else "").strip())
+    except Exception:
+        return ""
+    return "" if text.casefold() in ("null", "none", "<null>", "nan", "-") else text
+
+
+def key(value):
+    return clean(value).casefold()
+
+
+def _first(row, names):
+    row = dict(row or {})
+    for name in names:
+        value = clean(row.get(name))
+        if value:
+            return value
+    return ""
+
+
+@dataclass(frozen=True)
+class UnderbuildContext:
+    """Authoritative identity selected by the user for one Underbuild run."""
+
+    project_key: str
+    location_ids: tuple
+    location_name: str
+    stage: str
+
+    def __init__(self, project_key="", location_ids=(), location_name="", stage=""):
+        object.__setattr__(self, "project_key", clean(project_key))
+        object.__setattr__(
+            self,
+            "location_ids",
+            tuple(sorted({clean(value) for value in (location_ids or ()) if clean(value)})),
+        )
+        object.__setattr__(self, "location_name", clean(location_name))
+        object.__setattr__(self, "stage", stage_model.normalize_stage(stage))
+
+
+@dataclass(frozen=True)
+class CandidateDecision:
+    row: dict
+    accepted: bool
+    reason: str
+    source_kind: str
+
+
+@dataclass(frozen=True)
+class ResolutionResult:
+    accepted: list
+    rejected: list
+    decisions: list
+    rejection_counts: Counter
+
+
+def diagnostic_event(action, context, **fields):
+    """Return one structured, JSON-friendly Underbuild diagnostic event."""
+    context = (
+        context
+        if isinstance(context, UnderbuildContext)
+        else UnderbuildContext(**dict(context or {}))
+    )
+    event = {
+        "action": clean(action),
+        "project": context.project_key,
+        "location": context.location_name,
+        "location_ids": list(context.location_ids),
+        "stage": stage_model.stage_short_label(context.stage),
+    }
+    event.update(fields)
+    return event
+
+
+def _row_project(row):
+    return _first(row, ("project_key", "id_proyek", "project_id"))
+
+
+def _row_location_id(row):
+    return _first(row, ("id_lokasi", "location_id"))
+
+
+def _row_location_name(row):
+    return _first(
+        row,
+        ("lokasi_proyek", "nama_proyek", "project_location", "lokasi"),
+    )
+
+
+def candidate_decision(context, row, source_kind="work"):
+    """Decide one candidate and retain the exact rejection reason.
+
+    Populated canonical IDs are authoritative.  A display name may only rescue
+    a legacy row when that row does not carry a location ID at all.
+    """
+    context = context if isinstance(context, UnderbuildContext) else UnderbuildContext(**dict(context or {}))
+    row = dict(row or {})
+    kind = "existing" if key(source_kind) == "existing" else "work"
+
+    if not context.stage:
+        return CandidateDecision(row, False, "stage_missing", kind)
+
+    row_project = _row_project(row)
+    if context.project_key and row_project and key(row_project) != key(context.project_key):
+        return CandidateDecision(row, False, "project_mismatch", kind)
+
+    row_location_id = _row_location_id(row)
+    if context.project_key and not row_project and not row_location_id:
+        return CandidateDecision(row, False, "project_missing", kind)
+    wanted_location_ids = {key(value) for value in context.location_ids if key(value)}
+    if not wanted_location_ids:
+        return CandidateDecision(row, False, "location_unresolved", kind)
+    if row_location_id:
+        if key(row_location_id) not in wanted_location_ids:
+            return CandidateDecision(row, False, "location_mismatch", kind)
+    elif context.location_name:
+        if key(_row_location_name(row)) != key(context.location_name):
+            return CandidateDecision(row, False, "location_mismatch", kind)
+    elif wanted_location_ids:
+        return CandidateDecision(row, False, "location_missing", kind)
+
+    if kind != "existing":
+        row_stage = stage_model.feature_stage(row)
+        if row_stage != context.stage:
+            return CandidateDecision(row, False, "stage_mismatch", kind)
+
+    return CandidateDecision(row, True, "accepted", kind)
+
+
+def resolve_candidates(context, work_rows=(), existing_rows=()):
+    """Resolve work and Existing records through one deterministic path."""
+    decisions = []
+    for row in work_rows or ():
+        decisions.append(candidate_decision(context, row, "work"))
+    for row in existing_rows or ():
+        decisions.append(candidate_decision(context, row, "existing"))
+    accepted = [decision.row for decision in decisions if decision.accepted]
+    rejected = [decision for decision in decisions if not decision.accepted]
+    return ResolutionResult(
+        accepted=accepted,
+        rejected=rejected,
+        decisions=decisions,
+        rejection_counts=Counter(decision.reason for decision in rejected),
+    )
+
+
+def existing_carrier_reference(row):
+    """Return a persistent, non-FID reference for one Existing carrier."""
+    row = dict(row or {})
+    for field in ("feature_uuid", "uid_objek"):
+        value = clean(row.get(field))
+        if value:
+            return value
+    segment_id = clean(row.get("id_segmen"))
+    return "SEGMENT:{}".format(segment_id) if segment_id else ""
+
+
+def _carrier_edge_key(reference):
+    reference = clean(reference)
+    if not reference:
+        return ""
+    if key(reference).startswith("segment:"):
+        return "SEGMENT:{}".format(key(reference).split(":", 1)[1])
+    return "UUID:{}".format(key(reference))
+
+
+def host_edge_key(row):
+    """Stable identity of a host; provenance is identity only for overlays."""
+    row = dict(row or {})
+    explicit_host = clean(row.get("host_edge_uuid"))
+    if explicit_host:
+        return _carrier_edge_key(explicit_host)
+    source_kind = key(row.get("source_kind"))
+    if source_kind == "existing_overlay":
+        carrier = clean(row.get("parent_uid"))
+        if carrier:
+            return _carrier_edge_key(carrier)
+    if source_kind == "existing":
+        carrier = existing_carrier_reference(row)
+        if carrier:
+            return _carrier_edge_key(carrier)
+    for field in ("feature_uuid", "uid_objek"):
+        value = key(row.get(field))
+        if value:
+            return "UUID:{}".format(value)
+    segment_id = key(row.get("id_segmen"))
+    if segment_id:
+        return "SEGMENT:{}".format(segment_id)
+    layer_id = key(row.get("source_layer_id"))
+    fid = clean(row.get("fid"))
+    return "FID:{}:{}".format(layer_id, fid) if (layer_id or fid) else ""
+
+
+def _endpoint_identity(row, side):
+    prefix = "from" if side == "from" else "to"
+    legacy = "dari" if side == "from" else "ke"
+    uuid_value = _first(
+        row,
+        ("{}_feature_uuid".format(prefix), "{}_uuid".format(legacy)),
+    )
+    if uuid_value:
+        return "UUID:{}".format(key(uuid_value)), uuid_value
+    identifier = _first(row, ("{}_tiang".format(legacy), "{}_id".format(prefix)))
+    if identifier:
+        return "ID:{}".format(key(identifier)), identifier
+    return "", ""
+
+
+def _point_tuple(value):
+    try:
+        x, y = value
+        return float(x), float(y)
+    except Exception as exc:
+        raise ValueError("Endpoint geometry is missing or invalid.") from exc
+
+
+def _coordinate_node_id(point, tolerance):
+    scale = float(tolerance or 0.0)
+    if scale <= 0:
+        raise ValueError("Topology tolerance must be greater than zero.")
+    return "XY:{}:{}".format(
+        int(round(point[0] / scale)), int(round(point[1] / scale))
+    )
+
+
+def _node_for(graph, row, side, tolerance):
+    point = _point_tuple(row.get("{}_point".format(side)))
+    identity, raw_identity = _endpoint_identity(row, side)
+    coordinate_id = _coordinate_node_id(point, tolerance)
+
+    def nearby_nodes():
+        candidates = []
+        for candidate_id, candidate in graph["nodes"].items():
+            other = candidate.get("point")
+            distance = math.hypot(point[0] - other[0], point[1] - other[1])
+            if distance <= tolerance:
+                candidates.append((distance, candidate_id))
+        candidates.sort(key=lambda item: (item[0], item[1]))
+        return candidates
+
+    if identity:
+        node_id = graph["identity_nodes"].get(identity)
+        if node_id is None:
+            anonymous = [
+                item for item in nearby_nodes()
+                if not graph["nodes"][item[1]].get("identities")
+            ]
+            node_id = anonymous[0][1] if anonymous else identity
+            graph["identity_nodes"][identity] = node_id
+            if node_id not in graph["nodes"]:
+                graph["nodes"][node_id] = {
+                    "point": point,
+                    "identities": set(),
+                    "labels": [],
+                }
+        graph["nodes"][node_id]["identities"].add(identity)
+        if raw_identity and raw_identity not in graph["nodes"][node_id]["labels"]:
+            graph["nodes"][node_id]["labels"].append(raw_identity)
+        coordinate_owner = graph["coordinate_nodes"].get(coordinate_id)
+        if coordinate_owner is None and coordinate_id not in graph["ambiguous_coordinates"]:
+            graph["coordinate_nodes"][coordinate_id] = node_id
+        elif coordinate_owner != node_id:
+            graph["coordinate_nodes"].pop(coordinate_id, None)
+            graph["ambiguous_coordinates"].add(coordinate_id)
+        graph["aliases"][key(raw_identity)] = node_id
+        graph["aliases"][key(identity)] = node_id
+        return node_id
+
+    node_id = graph["coordinate_nodes"].get(coordinate_id)
+    if node_id is not None:
+        owner_point = graph["nodes"][node_id].get("point")
+        if math.hypot(
+                point[0] - owner_point[0], point[1] - owner_point[1]
+        ) > tolerance:
+            graph["coordinate_nodes"].pop(coordinate_id, None)
+            graph["ambiguous_coordinates"].add(coordinate_id)
+            node_id = None
+    if node_id is None:
+        nearby = nearby_nodes()
+        if len(nearby) == 1:
+            node_id = nearby[0][1]
+            if coordinate_id not in graph["ambiguous_coordinates"]:
+                graph["coordinate_nodes"][coordinate_id] = node_id
+    if node_id is None:
+        node_id = coordinate_id
+        suffix = 1
+        while node_id in graph["nodes"]:
+            suffix += 1
+            node_id = "{}:{}".format(coordinate_id, suffix)
+        if coordinate_id not in graph["ambiguous_coordinates"]:
+            graph["coordinate_nodes"][coordinate_id] = node_id
+        graph["nodes"][node_id] = {
+            "point": point, "identities": set(), "labels": [],
+        }
+    graph["aliases"][key(coordinate_id)] = node_id
+    return node_id
+
+
+def build_topology(records=(), tolerance=0.75):
+    """Build one deterministic graph from already-resolved work/Existing rows."""
+    tolerance = float(tolerance or 0.0)
+    if tolerance <= 0:
+        raise ValueError("Topology tolerance must be greater than zero.")
+    graph = {
+        "nodes": {}, "edges": {}, "adjacency": {}, "aliases": {},
+        "identity_nodes": {}, "coordinate_nodes": {},
+        "ambiguous_coordinates": set(),
+        "invalid_records": [], "tolerance": tolerance,
+    }
+    for source_index, source in enumerate(records or ()):
+        row = dict(source or {})
+        edge_key = host_edge_key(row)
+        if not edge_key:
+            graph["invalid_records"].append((source_index, "edge_identity_missing", row))
+            continue
+        try:
+            start = _node_for(graph, row, "from", tolerance)
+            end = _node_for(graph, row, "to", tolerance)
+            length = float(row.get("length") or 0.0)
+            if not math.isfinite(length) or length < 0:
+                raise ValueError("Edge length must be finite and non-negative.")
+            if start == end:
+                raise ValueError("Edge endpoints resolve to the same node.")
+        except Exception as exc:
+            graph["invalid_records"].append((source_index, clean(exc), row))
+            continue
+
+        edge = graph["edges"].get(edge_key)
+        if edge is None:
+            edge = {
+                "a": start,
+                "b": end,
+                "length": length,
+                "has_jtm": bool(row.get("has_jtm")),
+                "has_jtr": bool(row.get("has_jtr")),
+                "underbuild": bool(row.get("is_underbuild") or row.get("underbuild")),
+                "underbuild_identified": bool(clean(row.get("underbuild_path_id"))),
+                "records": [row],
+                "geometry": row.get("geometry"),
+            }
+            graph["edges"][edge_key] = edge
+        else:
+            if {edge["a"], edge["b"]} != {start, end}:
+                graph["invalid_records"].append(
+                    (source_index, "host_edge_endpoint_conflict", row)
+                )
+                continue
+            edge["length"] = max(float(edge.get("length") or 0.0), length)
+            edge["has_jtm"] = bool(edge.get("has_jtm") or row.get("has_jtm"))
+            edge["has_jtr"] = bool(edge.get("has_jtr") or row.get("has_jtr"))
+            edge["underbuild"] = bool(
+                edge.get("underbuild")
+                or row.get("is_underbuild")
+                or row.get("underbuild")
+            )
+            edge["underbuild_identified"] = bool(
+                edge.get("underbuild_identified")
+                or clean(row.get("underbuild_path_id"))
+            )
+            edge["records"].append(row)
+            if edge.get("geometry") is None and row.get("geometry") is not None:
+                edge["geometry"] = row.get("geometry")
+
+    adjacency = {node_id: [] for node_id in graph["nodes"]}
+    for edge_key, edge in graph["edges"].items():
+        if not edge.get("has_jtm"):
+            continue
+        adjacency[edge["a"]].append((edge["b"], edge_key))
+        adjacency[edge["b"]].append((edge["a"], edge_key))
+    for values in adjacency.values():
+        values.sort(key=lambda item: (item[1], item[0]))
+    graph["adjacency"] = adjacency
+    return graph
+
+
+def _resolve_node(graph, node):
+    if node in (graph or {}).get("nodes", {}):
+        return node
+    return (graph or {}).get("aliases", {}).get(key(node))
+
+
+def shortest_path(graph, start, end):
+    """Return the deterministic shortest JTM path as host edge identities."""
+    start = _resolve_node(graph, start)
+    end = _resolve_node(graph, end)
+    if start is None or end is None or start == end:
+        return []
+    heap = [(0.0, tuple(), start)]
+    best = {start: (0.0, tuple())}
+    while heap:
+        distance, path, node = heapq.heappop(heap)
+        if best.get(node) != (distance, path):
+            continue
+        if node == end:
+            return list(path)
+        for neighbor, edge_key in graph.get("adjacency", {}).get(node, ()):
+            edge = graph["edges"][edge_key]
+            candidate = (distance + float(edge.get("length") or 0.0), path + (edge_key,))
+            if neighbor not in best or candidate < best[neighbor]:
+                best[neighbor] = candidate
+                heapq.heappush(heap, (candidate[0], candidate[1], neighbor))
+    return []
+
+
+def shortest_path_count(graph, start, end, limit=3):
+    """Count equal shortest JTM routes, capped for UI ambiguity decisions."""
+    start = _resolve_node(graph, start)
+    end = _resolve_node(graph, end)
+    if start is None or end is None:
+        return 0
+    distances = {start: 0.0}
+    counts = {start: 1}
+    heap = [(0.0, start)]
+    epsilon = 1e-9
+    while heap:
+        distance, node = heapq.heappop(heap)
+        if distance > distances.get(node, float("inf")) + epsilon:
+            continue
+        for neighbor, edge_key in graph.get("adjacency", {}).get(node, ()):
+            candidate = distance + float(graph["edges"][edge_key].get("length") or 0.0)
+            previous = distances.get(neighbor, float("inf"))
+            if candidate < previous - epsilon:
+                distances[neighbor] = candidate
+                counts[neighbor] = counts.get(node, 1)
+                heapq.heappush(heap, (candidate, neighbor))
+            elif abs(candidate - previous) <= epsilon:
+                counts[neighbor] = min(
+                    max(1, int(limit or 1)),
+                    counts.get(neighbor, 0) + counts.get(node, 1),
+                )
+    return int(counts.get(end, 0))
+
+
+@dataclass(frozen=True)
+class UnderbuildPartition:
+    covered: list
+    pending: list
+    covered_length: float
+    pending_length: float
+    legacy_unidentified: list
+    legacy_unidentified_length: float
+
+
+def partition_underbuild_edges(graph, path):
+    """Split a selected path into existing and new Underbuild host edges."""
+    covered, pending, legacy_unidentified = [], [], []
+    covered_length = pending_length = legacy_unidentified_length = 0.0
+    for edge_key in path or ():
+        edge = (graph or {}).get("edges", {}).get(edge_key)
+        if edge is None:
+            raise ValueError("Selected path references an unknown host edge.")
+        length = float(edge.get("length") or 0.0)
+        if edge.get("underbuild") and edge.get("underbuild_identified"):
+            covered.append(edge_key)
+            covered_length += length
+        else:
+            pending.append(edge_key)
+            pending_length += length
+            if edge.get("underbuild"):
+                legacy_unidentified.append(edge_key)
+                legacy_unidentified_length += length
+    return UnderbuildPartition(
+        covered=covered,
+        pending=pending,
+        covered_length=covered_length,
+        pending_length=pending_length,
+        legacy_unidentified=legacy_unidentified,
+        legacy_unidentified_length=legacy_unidentified_length,
+    )
+
+
+def existing_underbuild_path_ids(graph, path):
+    """Return the one reusable route identity or reject an ambiguous merge."""
+    identities = {}
+    for edge_key in path or ():
+        edge = (graph or {}).get("edges", {}).get(edge_key)
+        if edge is None:
+            raise ValueError("Selected path references an unknown host edge.")
+        if not edge.get("underbuild"):
+            continue
+        for row in edge.get("records", ()):
+            path_id = clean(row.get("underbuild_path_id"))
+            if path_id:
+                identities.setdefault(key(path_id), path_id)
+    if len(identities) > 1:
+        raise ValueError(
+            "Jalur terpilih menghubungkan lebih dari satu identitas "
+            "Underbuild. Pilih satu perpanjangan jalur pada satu waktu."
+        )
+    return tuple(
+        identities[name] for name in sorted(identities)
+    )
+
+
+def validate_selected_path(graph, path, start=None, end=None, context=None):
+    """Validate that a write path is one connected, scoped JTM edge chain."""
+    path = list(path or ())
+    if not path:
+        raise ValueError("Jalur Underbuild kosong.")
+    if len(set(path)) != len(path):
+        raise ValueError("Jalur Underbuild memuat edge duplikat.")
+
+    edges = (graph or {}).get("edges", {})
+    for edge_key in path:
+        edge = edges.get(edge_key)
+        if edge is None:
+            raise ValueError("Jalur Underbuild merujuk edge yang tidak dikenal.")
+        if not bool(edge.get("has_jtm") or edge.get("jtm")):
+            raise ValueError("Jalur Underbuild memuat edge yang bukan host JTM.")
+        if context is not None:
+            for row in edge.get("records", ()):
+                decision = candidate_decision(
+                    context, row, row.get("source_kind", "work")
+                )
+                if not decision.accepted:
+                    raise ValueError(
+                        "Jalur Underbuild keluar dari scope aktif: {}."
+                        .format(decision.reason)
+                    )
+
+    wanted_start = _resolve_node(graph, start) if start is not None else None
+    wanted_end = _resolve_node(graph, end) if end is not None else None
+    first = edges[path[0]]
+    if wanted_start is None:
+        current = first["a"]
+    elif wanted_start in (first["a"], first["b"]):
+        current = wanted_start
+    else:
+        raise ValueError("Jalur Underbuild tidak dimulai pada node terpilih.")
+
+    for edge_key in path:
+        edge = edges[edge_key]
+        if current == edge["a"]:
+            current = edge["b"]
+        elif current == edge["b"]:
+            current = edge["a"]
+        else:
+            raise ValueError("Urutan edge jalur Underbuild tidak tersambung.")
+    if wanted_end is not None and current != wanted_end:
+        raise ValueError("Jalur Underbuild tidak berakhir pada node terpilih.")
+    return path
