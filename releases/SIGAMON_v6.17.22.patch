+# -*- coding: utf-8 -*-
+"""Behavior tests for the QGIS-free Underbuild topology engine."""
+import ast
+import unittest
+
+try:
+    import _bootstrap
+except ModuleNotFoundError:
+    from tests import _bootstrap
+
+read_module = _bootstrap.read_module
+
+try:
+    import underbuild_topology as topology
+except ModuleNotFoundError:
+    topology = None
+
+
+def work_row(edge, stage, project="P-2026", location_id="LOC-A",
+             location_name="Kayawu", **extra):
+    row = {
+        "feature_uuid": edge,
+        "tahap_data": stage,
+        "status_data": "Aktual" if stage == "Realisasi" else "Rencana",
+        "id_proyek": project,
+        "id_lokasi": location_id,
+        "lokasi_proyek": location_name,
+        "source_kind": "work",
+    }
+    row.update(extra)
+    return row
+
+
+def existing_row(edge, project="P-2026", location_id="LOC-A",
+                 location_name="Kayawu", **extra):
+    row = {
+        "feature_uuid": edge,
+        "tahap_data": "Eksisting",
+        "status_data": "Eksisting",
+        "id_proyek": project,
+        "id_lokasi": location_id,
+        "lokasi_proyek": location_name,
+        "source_kind": "existing",
+    }
+    row.update(extra)
+    return row
+
+
+def topology_edge(edge, start, end, length=50.0, source="work",
+                  underbuild=False, has_jtm=True, has_jtr=False, **extra):
+    row = {
+        "feature_uuid": edge,
+        "from_point": start,
+        "to_point": end,
+        "from_feature_uuid": "NODE-{}-{}".format(start[0], start[1]),
+        "to_feature_uuid": "NODE-{}-{}".format(end[0], end[1]),
+        "length": length,
+        "source_kind": source,
+        "has_jtm": has_jtm,
+        "has_jtr": has_jtr,
+        "is_underbuild": underbuild,
+    }
+    row.update(extra)
+    return row
+
+
+class CandidateResolverTests(unittest.TestCase):
+    """Each test catches a wrong scope/stage branch in the resolver."""
+
+    def setUp(self):
+        self.assertIsNotNone(
+            topology,
+            "underbuild_topology.py must provide the scoped resolver",
+        )
+        self.context = topology.UnderbuildContext(
+            project_key="P-2026",
+            location_ids=("LOC-A",),
+            location_name="Kayawu",
+            stage="Rencana Awal",
+        )
+
+    def test_rencana_awal_never_accepts_rencana_akhir(self):
+        result = topology.resolve_candidates(
+            self.context,
+            [work_row("AWAL", "Rencana Awal"),
+             work_row("AKHIR", "Rencana Akhir")],
+            [],
+        )
+        self.assertEqual(["AWAL"], [row["feature_uuid"] for row in result.accepted])
+        self.assertEqual(1, result.rejection_counts["stage_mismatch"])
+
