+        apply_body = method_source(
+            self.source, "UnderbuildRangeDialog", "apply_underbuild"
+        )
+        self.assertIn("existing_underbuild_path_ids", apply_body)
+        self.assertIn("existing_path_ids[0]", apply_body)
+
+    def test_overlapping_click_candidates_have_deterministic_selection_ui(self):
+        body = method_source(
+            self.source, "UnderbuildRangeDialog", "_nearest_node"
+        )
+        self.assertIn("QInputDialog.getItem", body)
+        self.assertIn("sorted", body)
+
+
+if __name__ == "__main__":
+    unittest.main()
