+        """Simpan/hapus override jarak satu gawang tanpa mengubah geometry."""
+        row = dict(row or {})
+        manual = None
+        if value is not None:
+            manual = pln_span_distance.positive_distance(value)
+            if manual is None:
+                raise ValueError("Jarak manual harus berupa angka lebih dari 0.")
+        layer_name = pln_stage.clean(row.get("layer_name"))
+        layer = self.get_layer(layer_name) if layer_name else None
+        fid = row.get("fid")
+        if layer is None or fid is None:
+            raise ValueError("Feature gawang tidak ditemukan.")
+        feature = self._feature_by_id(layer, int(fid))
+        if feature is None:
+            raise ValueError("Feature gawang tidak ditemukan.")
+        self.ensure_fields(layer, [QgsField("manual_distance", FIELD_DOUBLE)])
+        fields = self._field_names(layer)
+        automatic = 0.0
+        for name in LENGTH_FIELD_PRIORITY:
+            if name == "manual_distance" or name not in fields:
+                continue
+            candidate = self._num_or_none(feature, name)
+            if candidate is not None:
+                automatic = float(candidate)
+                break
+        shown = manual or automatic or self._geometry_length_m(layer, feature)
+        changes = {"manual_distance": manual}
+        for label_field in ("label_panjang", "_pdf_label_panjang"):
+            if label_field not in fields:
+                continue
+            current = str(self.get_feature_value_safe(
+                feature, label_field, ""
+            ) or "").strip().casefold()
+            if current not in ("sembunyikan", "hide", "hidden"):
+                changes[label_field] = "{:.1f} m{}".format(
+                    shown, "*" if manual is not None else ""
+                )
+        # Mutasi atribut saja; geometri tidak disentuh.
+        if not change_attributes_safe(layer, int(fid), changes):
+            raise RuntimeError("Provider menolak penyimpanan jarak manual.")
+        try:
+            layer.triggerRepaint()
+        except Exception:
+            pass
+        return True
 
