+import math
+import unittest
+
+import boq_control as bc
+import span_distance as distance
+
+
+class SpanDistanceCoreTests(unittest.TestCase):
+    def test_default_uses_geometry(self):
+        row = distance.resolve_span_distance(47.6)
+        self.assertEqual(47.6, row["effective_distance"])
+        self.assertEqual("Otomatis", row["distance_source"])
+
+    def test_manual_overrides_without_changing_geometry(self):
+        row = distance.resolve_span_distance(47.6, 50.0)
+        self.assertEqual(47.6, row["geometry_distance"])
+        self.assertEqual(50.0, row["effective_distance"])
+        self.assertEqual("Manual", row["distance_source"])
+
+    def test_reset_is_the_same_as_no_manual_value(self):
+        self.assertEqual(
+            distance.resolve_span_distance(47.6),
+            distance.resolve_span_distance(47.6, None),
+        )
+
+    def test_invalid_manual_values_never_override(self):
+        for value in (0, -1, "", "abc", math.nan, math.inf, -math.inf):
+            with self.subTest(value=value):
+                row = distance.resolve_span_distance(47.6, value)
+                self.assertEqual(47.6, row["effective_distance"])
+                self.assertEqual("Otomatis", row["distance_source"])
+
+    def test_legacy_automatic_distance_is_preserved(self):
+        row = distance.resolve_span_distance(47.6, None, 48.2)
+        self.assertEqual(47.6, row["geometry_distance"])
+        self.assertEqual(48.2, row["effective_distance"])
+
+
+class CableCalculationTests(unittest.TestCase):
+    def test_manual_distance_drives_sutr_need(self):
+        rows = bc.build_span_rows([{
+            "feature_uuid": "span-1", "dari_tiang": "TR-001",
+            "ke_tiang": "TR-002", "panjang": 47.6,
+            "panjang_geometri": 47.6, "manual_distance": 50.0,
+            "has_tr": True,
+        }])
+        self.assertEqual(47.6, rows[0]["panjang_geometri"])
+        self.assertEqual(50.0, rows[0]["jarak_perhitungan"])
+        self.assertEqual("Manual", rows[0]["status_jarak"])
+        self.assertAlmostEqual(51.5, rows[0]["kebutuhan"])
+
+    def test_manual_distance_drives_three_phase_sutm_need(self):
+        rows = bc.build_span_rows([{
+            "feature_uuid": "span-2", "panjang": 47.6,
+            "panjang_geometri": 47.6, "manual_distance": 50.0,
+            "has_tm": True,
+        }])
+        self.assertEqual(150.0, rows[0]["dasar_kabel"])
+        self.assertAlmostEqual(153.75, rows[0]["kebutuhan"])
+
+    def test_overrides_are_independent_per_span_and_stage_input(self):
+        awal = bc.build_span_rows([{
+            "feature_uuid": "awal", "panjang": 47.6, "manual_distance": None,
+            "has_tr": True,
+        }])[0]
+        akhir = bc.build_span_rows([{
+            "feature_uuid": "akhir", "panjang": 47.6, "manual_distance": 50,
+            "has_tr": True,
+        }])[0]
+        real = bc.build_span_rows([{
+            "feature_uuid": "real", "panjang": 48.2, "manual_distance": 49.5,
+            "has_tr": True,
+        }])[0]
+        self.assertEqual([47.6, 50.0, 49.5], [
+            awal["jarak_perhitungan"], akhir["jarak_perhitungan"],
+            real["jarak_perhitungan"],
+        ])
+
+
+class SourceContractTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        with open("plugin.py", encoding="utf-8") as handle:
+            cls.source = handle.read()
+
+    def test_manual_edit_is_attribute_only(self):
+        start = self.source.index("    def set_span_manual_distance")
+        end = self.source.index("\n    def ", start + 10)
+        body = self.source[start:end]
+        self.assertIn("change_attributes_safe", body)
+        for forbidden in (
+            "changeGeometry", "moveFeature", "moveVertex", "translate(",
+            "change_geometry_safe", "setGeometry",
+        ):
+            self.assertNotIn(forbidden, body)
+
+    def test_detail_has_edit_and_reset_actions(self):
+        self.assertIn('"✎  Ubah Jarak"', self.source)
+        self.assertIn('"↺  Jarak Geometri"', self.source)
+
