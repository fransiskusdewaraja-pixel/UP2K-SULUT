+def topology_layer_names(kind, stage, include_existing=True):
+    """Nama layer node valid untuk satu tahap jaringan.
+
+    Existing adalah referensi fisik bersama, bukan tahap baru. Karena itu
+    jaringan Rencana Awal/Akhir memakai layer tahap ``*_RENCANA`` *dan*
+    ``*_EKSISTING``; Realisasi memakai ``*_AKTUAL`` dan ``*_EKSISTING``.
+    Urutan ini penting: objek tahap dicari lebih dulu, Existing menjadi node
+    bersama tanpa pernah disalin atau diduplikasi ke layer tahap.
+    """
+    object_kind = clean(kind).upper()
+    normalized = normalize_stage(stage)
+    if not object_kind or normalized not in BOQ_STAGES:
+        return ()
+    names = ["{}_{}".format(
+        object_kind, layer_suffix_for_stage(normalized, "")
+    )]
+    if include_existing:
+        names.append("{}_EKSISTING".format(object_kind))
+    return tuple(name for name in names if name and not name.endswith("_"))
+
