+def endpoint_identity_matches(point_uuid, point_id, endpoint_pairs):
+    """UUID-first endpoint match with a safe legacy-ID fallback.
+
+    When both sides have UUID, a conflicting UUID may never fall back to a
+    duplicated display ID. ID is used only when either endpoint side is legacy
+    and has no UUID.
+    """
+    puid, pid = _key(point_uuid), _key(point_id)
+    for endpoint_uuid, endpoint_id in endpoint_pairs or ():
