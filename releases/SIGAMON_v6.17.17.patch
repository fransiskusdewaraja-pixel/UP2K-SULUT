+# -*- coding: utf-8 -*-
+"""Kontrak integrasi underbuild: TIANG_EKSISTING adalah node nyata bersama."""
+import ast
+import unittest
+
+import _bootstrap
+from _bootstrap import read_module
+
+
+def method_source(source, name):
+    tree = ast.parse(source)
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == name:
+            return ast.get_source_segment(source, node) or ""
+    raise AssertionError("Method {} tidak ditemukan".format(name))
+
+
+class ExistingUnderbuildIntegrationContractTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = read_module("plugin.py")
+
+    def test_range_picker_exposes_existing_nodes_in_plan_and_actual(self):
+        class_source = self.source[
+            self.source.index("class DashboardNetworkRangeDialog"): 
+            self.source.index("class UnderbuildRangeDialog")
+        ]
+        for status in ("Rencana", "Aktual"):
+            self.assertIn('"{}"'.format(status), class_source)
+        self.assertGreaterEqual(class_source.count('"TIANG_EKSISTING"'), 3)
+
+    def test_add_underbuild_resolves_all_topology_point_layers(self):
+        source = method_source(self.source, "apply_underbuild")
+        self.assertIn("topology_point_layers_for_stage", source)
+        self.assertIn("same_topology_scope", source)
+        self.assertIn("endpoint_identity_matches", source)
+        self.assertIn("list(point_layers) + [network_layer]", source)
+
+    def test_recalculation_writes_existing_anchor_in_same_transaction(self):
+        source = method_source(self.source, "_recalculate_underbuild_edit")
+        self.assertIn("same_topology_scope", source)
+        self.assertIn("_sync_existing_anchor_pull_feature", source)
+        self.assertIn("is_existing", source)
+        self.assertIn('slot_values(\n                        "TR-3"', source)
+
+    def test_delete_underbuild_recalculates_stage_and_existing_nodes(self):
+        source = method_source(self.source, "delete_underbuild_path")
+        self.assertIn("topology_point_layers_for_stage", source)
+        self.assertIn("endpoint_pairs=endpoint_pairs", source)
+        self.assertIn("list(point_layers) + [layer]", source)
+
+    def test_helper_only_resolves_layers_and_never_copies_features(self):
+        source = method_source(self.source, "topology_point_layers_for_stage")
+        self.assertIn("topology_layer_names", source)
+        for forbidden in ("addFeature", "QgsFeature(", "clone", "copy"):
+            self.assertNotIn(forbidden, source)
+
+
+if __name__ == "__main__":
+    unittest.main()
