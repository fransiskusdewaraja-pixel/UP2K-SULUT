+def _physical_pole_identity(record):
+    """Identitas anchor fisik untuk TM-4X, aman lintas Lokasi Proyek.
+
+    TM-4X adalah satu konstruksi pada satu tiang eksisting, bukan satu per
+    edge yang keluar darinya. UUID adalah kunci utama. Data lama tanpa UUID
+    memakai proyek + Lokasi Proyek + ID tiang agar ID sama pada dua lokasi
+    berdekatan tidak saling menghapus.
+    """
+    rec = record or {}
+    uuid = str(rec.get("feature_uuid") or "").strip().casefold()
+    if uuid:
+        return ("uuid", uuid)
+    project = str(
+        rec.get("project_key") or rec.get("id_proyek") or ""
+    ).strip().casefold()
+    location = str(
+        rec.get("id_lokasi") or rec.get("lokasi_proyek") or ""
+    ).strip().casefold()
+    pole_id = str(
+        rec.get("id") or rec.get("id_tiang") or rec.get("fid") or ""
+    ).strip().casefold()
+    return ("legacy", project, location, pole_id)
