+import boq_control as boq
+import spreadsheet_schema as schema
+
+
+class SpanTopologyTests(unittest.TestCase):
+    def test_traversal_follows_connections_and_keeps_branches(self):
+        rows = [
+            {"feature_uuid": "c", "dari_tiang": "T-2", "ke_tiang": "T-4"},
+            {"feature_uuid": "a", "dari_tiang": "G-1", "ke_tiang": "T-1"},
+            {"feature_uuid": "b", "dari_tiang": "T-1", "ke_tiang": "T-2"},
+            {"feature_uuid": "d", "dari_tiang": "T-1", "ke_tiang": "T-3"},
+        ]
+        ordered = boq.order_span_topology(rows)
+        self.assertEqual(["a", "b", "c", "d"], [row["feature_uuid"] for row in ordered])
+
+
+class SpreadsheetSpanDetailTests(unittest.TestCase):
+    def snapshot(self):
+        base = {
+            "id_lokasi": "L1", "lokasi": "Lokasi A", "key": "span-1",
+            "dari_tiang": "G-1", "ke_tiang": "T-1", "panjang": 10.04,
+            "has_tm": True, "has_tr": False, "tipe_kabel": "AAAC",
+            "sagging_sutm": 2.5, "konstruksi_terkait": "TM-4X",
+            "tambahan_konstruksi_sutm": 3.0,
+        }
+        return {
+            "location_metadata": {"L1": {
+                "id_lokasi": "L1", "lokasi": "Lokasi A", "proyek": "APBN 2026"
+            }},
+            "kontrol_tarikan": {
+                "RENCANA_AWAL": [dict(base)],
+                "RENCANA_AKHIR": [dict(base)],
+                "REALISASI": [dict(base, panjang=9.9, sagging_sutm=4.0)],
+            },
+        }
+
+    def test_detail_keeps_one_decimal_and_ceil_only_summary(self):
+        layout = schema.build_detail_stage_layout(
+            self.snapshot(), schema.SHEET_DETAIL_AWAL
+        )
+        detail, summary = layout.values[1], layout.values[2]
+        self.assertAlmostEqual(10.04, detail[18])
+        raw = 10.04 * 3 + (10.04 * 3 * 0.025) + 3.0
+        self.assertAlmostEqual(raw, detail[23])
+        self.assertEqual(math.ceil(raw), summary[23])
+
+    def test_realisasi_status_is_only_on_summary(self):
+        layout = schema.build_detail_stage_layout(
+            self.snapshot(), schema.SHEET_DETAIL_REALISASI
+        )
+        detail, summary = layout.values[1], layout.values[2]
+        self.assertEqual("", detail[26])
+        self.assertIn(summary[26], ("Kurang", "Sesuai", "Lebih"))
+
+    def test_control_payload_contains_three_stage_sheets(self):
+        titles = [title for title, _layout in schema.build_control_payload(self.snapshot())]
+        self.assertEqual([
+            "Rencana Awal", "Rencana Akhir", "Realisasi"
+        ], titles[5:8])
+
+
+if __name__ == "__main__":
+    unittest.main()
