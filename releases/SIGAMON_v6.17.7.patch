+                            source.get("tipe_kabel")))
+        for classification, multiplier, percent, cable_type in classes:
+            kms = _number(source.get("panjang"))
+            percent = _number(percent)
+            sagging = kms * multiplier * percent / 100.0
+            construction_extra = (
+                _number(source.get("tambahan_konstruksi_sutm"))
+                if classification == "SUTM" else 0.0
+            )
+            row = dict(source)
+            row.update({
+                "classification": classification,
+                "cable_type": clean(cable_type) or UNSPECIFIED_CABLE,
+                "kms": kms, "percent": percent, "sagging_m": sagging,
+                "construction_extra": construction_extra,
+                "need": kms * multiplier + sagging + construction_extra,
+            })
+            rows.append(row)
+    return rows
+
+
+def _detail_totals(snapshot, stage_key):
+    totals = {}
