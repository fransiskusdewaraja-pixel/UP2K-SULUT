+def _natural_span_key(value):
+    """Kunci natural kecil untuk traversal topologi yang deterministik."""
+    return tuple(
+        int(part) if part.isdigit() else part.casefold()
+        for part in re.split(r"(\d+)", clean(value))
+    )
+
+
+def order_span_topology(spans):
+    """Urutkan feature gawang mengikuti konektivitas jaringan sebenarnya.
+
+    Setiap edge tetap muncul sekali. Akar komponen dipilih dari node dengan
+    indegree nol (umumnya Gardu/awal tarikan); cabang ditelusuri secara
+    depth-first dan diurutkan natural agar hasil sinkronisasi stabil. Untuk
+    data lama yang arahnya terbalik/berbentuk siklus, edge terkecil yang
+    belum dipakai menjadi akar cadangan tanpa menghilangkan data.
+    """
+    source = [dict(row or {}) for row in spans or ()]
+    outgoing, indegree = {}, {}
+    for index, row in enumerate(source):
+        start, end = clean(row.get("dari_tiang")), clean(row.get("ke_tiang"))
+        outgoing.setdefault(start, []).append(index)
+        indegree.setdefault(start, 0)
+        indegree[end] = indegree.get(end, 0) + 1
+    for values in outgoing.values():
+        values.sort(key=lambda i: (
+            _natural_span_key(source[i].get("id_jalur")),
+            _natural_span_key(source[i].get("ke_tiang")),
+            _natural_span_key(span_key(source[i])),
+        ))
+    roots = sorted(
+        (node for node in outgoing if indegree.get(node, 0) == 0),
+        key=_natural_span_key,
+    )
+    used, ordered = set(), []
+
+    def walk(node):
+        for index in outgoing.get(node, ()):
+            if index in used:
+                continue
+            used.add(index)
+            ordered.append(source[index])
+            walk(clean(source[index].get("ke_tiang")))
+
+    for root in roots:
+        walk(root)
+    while len(used) < len(source):
+        index = min(
+            (i for i in range(len(source)) if i not in used),
+            key=lambda i: (
+                _natural_span_key(source[i].get("dari_tiang")),
+                _natural_span_key(source[i].get("ke_tiang")),
+                _natural_span_key(span_key(source[i])),
+            ),
+        )
+        used.add(index)
+        ordered.append(source[index])
+        walk(clean(source[index].get("ke_tiang")))
+    return ordered
+
+
