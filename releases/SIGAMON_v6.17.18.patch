--- SIGAMON_v6.17.17/underbuild_termination.py	2026-09-10 22:52:54.000000000 +0900
+++ SIGAMON_v6.17.18/underbuild_termination.py	2026-09-11 14:25:52.000000000 +0900
@@ -306,3 +306,45 @@
         if pid and eid and pid == eid:
             return True
     return False
+
+
+def endpoint_topology_matches(network, point, point_uuid, point_id,
+                              endpoint_pairs):
+    """Endpoint valid dalam scope tahap/lokasi, dengan UUID sebagai utama.
+
+    UUID identik boleh memulihkan feature lama yang belum mempunyai metadata
+    Lokasi Proyek. Namun identitas lokasi/proyek yang sama-sama terisi dan
+    bertentangan selalu ditolak. Fallback ID hanya berlaku setelah scope
+    lokasi cocok penuh; ``TS-002`` di dua lokasi tidak pernah disamakan hanya
+    karena ID atau geometri berdekatan.
+    """
+    network, point = dict(network or {}), dict(point or {})
+    network_project = _key(network.get("project_key"))
+    point_project = _key(point.get("project_key"))
+    if network_project and point_project and network_project != point_project:
+        return False
+    network_location = _key(network.get("id_lokasi"))
+    point_location = _key(point.get("id_lokasi"))
+    if (network_location and point_location
+            and network_location != point_location):
+        return False
+    point_stage = _key(point.get("tahap_data"))
+    if not (
+        point_stage in ("eksisting", "existing")
+        or point_stage == _key(network.get("tahap_data"))
+    ):
+        return False
+
+    puid = _key(point_uuid)
+    exact_uuid = any(
+        puid and _key(endpoint_uuid) == puid
+        for endpoint_uuid, _endpoint_id in endpoint_pairs or ()
+    )
+    if exact_uuid:
+        return True
+    return bool(
+        same_topology_scope(network, point)
+        and endpoint_identity_matches(
+            point_uuid, point_id, endpoint_pairs
+        )
+    )
