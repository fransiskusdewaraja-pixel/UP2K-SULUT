+# -*- coding: utf-8 -*-
+"""Kontrak warna jaringan Eksisting: JTM merah, JTR biru, semuanya solid."""
+import ast
+import unittest
+
+import _bootstrap
+
+from test_location_ui_contract import method_source
+
+
+class ExistingNetworkStyleTests(unittest.TestCase):
+
+    @classmethod
+    def setUpClass(cls):
+        cls.source = _bootstrap.read_module("plugin.py")
+
+    def test_existing_uses_the_shared_type_renderer(self):
+        body = method_source(self.source, "apply_jaringan_eksisting_style")
+        self.assertIn("self._apply_jaringan_type_style(", body)
+        self.assertIn("dashed=False", body)
+        self.assertIn('suffix="Eksisting"', body)
+        self.assertIn("width=0.38", body)
+
+    def test_jtm_is_red_and_jtr_is_blue(self):
+        body = method_source(self.source, "_apply_jaringan_type_style")
+        self.assertIn('"220,0,0"', body)
+        self.assertIn('"0,80,220"', body)
+        self.assertIn("jtm_expr", body)
+        self.assertIn("jtr_expr", body)
+
+    def test_underbuild_uses_both_type_colours_with_the_same_line_pattern(self):
+        body = method_source(self.source, "_apply_jaringan_type_style")
+        self.assertIn(
+            "self.underbuild_line_symbol(width=width, dashed=dashed)", body
+        )
+
+    def test_existing_is_no_longer_a_single_purple_symbol(self):
+        body = method_source(self.source, "apply_jaringan_eksisting_style")
+        self.assertNotIn("150,0,200", body)
+        self.assertNotIn("QgsSingleSymbolRenderer", body)
+
+    def test_actual_and_existing_share_the_same_renderer(self):
+        actual = method_source(self.source, "apply_jaringan_style")
+        existing = method_source(self.source, "apply_jaringan_eksisting_style")
+        self.assertIn("self._apply_jaringan_type_style(", actual)
+        self.assertIn("self._apply_jaringan_type_style(", existing)
+
+    def test_dashboard_existing_fallback_is_also_solid_and_type_coloured(self):
+        body = method_source(self.source, "_apply_dashboard_temp_style")
+        existing = body.index('elif "EKSISTING" in name:')
+        fallback = body.index("self.plugin._apply_jaringan_type_style", existing)
+        self.assertIn("dashed=False", body[fallback:fallback + 180])
+        self.assertIn('suffix="Eksisting"', body[fallback:fallback + 180])
+
+    def test_plugin_still_parses(self):
+        ast.parse(self.source, filename=_bootstrap.module_path("plugin.py"))
+
+
+if __name__ == "__main__":
+    unittest.main()
