+def _work_status(stage, explicit=""):
+    """Status existing; fallback hanya mengikuti dua ujung tahap resmi."""
+    value = clean(explicit)
+    if value in STATUS_ORDER:
+        return value
+    stage_value = clean(stage).casefold()
+    if stage_value == "slo terbit":
+        return "Selesai"
+    if not stage_value or stage_value == "kontrak":
+        return "Belum Dikerjakan"
+    return "Dalam Proses"
+
+
+def _progress_percent(stage, value):
+    """Nilai progress tersimpan, dijepit 0..100 dan dikirim sebagai persen."""
+    if value is None or clean(value) == "":
+        defaults = {
+            "kontrak": 0.0, "penggalian": 15.0,
+            "penanaman tiang": 35.0, "pemasangan konstruksi": 55.0,
+            "penarikan jaringan": 75.0, "komisioning": 95.0,
+            "slo terbit": 100.0,
+        }
+        value = defaults.get(clean(stage).casefold(), 0.0)
+    return min(100.0, max(0.0, _number(value)))
+
+
+def progress_location_records(snapshot):
+    """Satu sumber kanonik bagi ketiga sheet progress, satu row per lokasi."""
+    records = list((snapshot or {}).get("locations") or [])
+    unique = {}
+    for record in records:
+        record = dict(record or {})
+        project = clean(record.get("judul_proyek"))
+        location = clean(
+            record.get("nama_proyek") or record.get("lokasi_proyek")
+            or record.get("location") or record.get("lokasi")
+        )
+        location_id = clean(record.get("id_lokasi"))
+        project_id = clean(record.get("id_proyek"))
+        if not location and not location_id:
+            continue
+        identity = (
+            project_id or norm_key(project),
+            location_id or norm_key(location),
+        )
+        stage = clean(record.get("current_stage")) or "Kontrak"
+        progress = _progress_percent(stage, record.get("progress_proyek"))
+        status = _work_status(stage, record.get("status_proyek"))
+        if status == "Selesai":
+            progress = 100.0
+        unique[identity] = {
+            "project": project,
+            "location": location,
+            "package": clean(record.get("paket")),
+            "phase": clean(record.get("tahap")),
+            "up3": clean(record.get("up3")),
+            "ulp": clean(record.get("ulp")),
+            "vendor_mdu": clean(record.get("vendor_mdu") or record.get("vendor")),
+            "vendor_jasa": clean(record.get("vendor_jasa")),
+            "work_stage": stage,
+            "status": status,
+            "progress": progress,
+            "notes": clean(record.get("keterangan")),
+            "updated": clean(record.get("last_update") or record.get("updated_at")),
