+        _PROGRESS_LOCATION_WIDTHS,
+    ).numbers({12: PERCENT_NUMBER_FORMAT}).status_column(11)
+    for number, row in enumerate(progress_location_records(snapshot), 1):
+        table.add([
+            number, row["project"], row["location"], row["package"],
+            row["phase"], row["up3"], row["ulp"], row["vendor_mdu"],
+            row["vendor_jasa"], row["work_stage"], row["status"],
+            row["progress"] / 100.0, row["notes"],
+            display_time(row["updated"]),
+        ])
+    return table.finish()
+
+
+def _progress_buckets(rows, key_fields):
+    buckets = {}
+    for row in rows:
+        key = tuple(row[field] for field in key_fields)
+        bucket = buckets.setdefault(key, {
+            "rows": [], "updates": [],
+            "Belum Dikerjakan": 0, "Dalam Proses": 0, "Selesai": 0,
+        })
+        bucket["rows"].append(row)
+        bucket[row["status"]] += 1
+        if row["updated"]:
+            bucket["updates"].append(row["updated"])
+    return buckets
+
+
+def build_progress_up3_layout(snapshot):
+    rows = progress_location_records(snapshot)
+    table = FlatTable(
+        SHEET_PROGRESS_UP3, PROGRESS_UP3_HEADERS, _PROGRESS_SUMMARY_WIDTHS,
+    ).numbers({4: INTEGER_NUMBER_FORMAT, 5: INTEGER_NUMBER_FORMAT,
+               6: INTEGER_NUMBER_FORMAT, 7: INTEGER_NUMBER_FORMAT,
+               8: PERCENT_NUMBER_FORMAT})
+    buckets = _progress_buckets(rows, ("project", "up3"))
+    for number, key in enumerate(sorted(
+            buckets, key=lambda item: (natural_key(item[0]), natural_key(item[1]))
+    ), 1):
+        project, up3 = key
+        bucket = buckets[key]
+        count = len(bucket["rows"])
+        average = sum(row["progress"] for row in bucket["rows"]) / count
+        table.add([
+            number, project, up3, count, bucket["Belum Dikerjakan"],
+            bucket["Dalam Proses"], bucket["Selesai"], average / 100.0,
+            display_time(max(bucket["updates"]) if bucket["updates"] else ""),
+        ])
+    return table.finish()
+
+
+def build_progress_project_layout(snapshot):
+    rows = progress_location_records(snapshot)
+    table = FlatTable(
+        SHEET_PROGRESS_PROJECT, PROGRESS_PROJECT_HEADERS,
+        _PROGRESS_SUMMARY_WIDTHS,
+    ).numbers({3: INTEGER_NUMBER_FORMAT, 4: INTEGER_NUMBER_FORMAT,
+               5: INTEGER_NUMBER_FORMAT, 6: INTEGER_NUMBER_FORMAT,
+               7: INTEGER_NUMBER_FORMAT, 8: PERCENT_NUMBER_FORMAT})
+    buckets = _progress_buckets(rows, ("project",))
+    for number, key in enumerate(sorted(
+            buckets, key=lambda item: natural_key(item[0])
+    ), 1):
+        project = key[0]
+        bucket = buckets[key]
+        count = len(bucket["rows"])
+        average = sum(row["progress"] for row in bucket["rows"]) / count
+        total_up3 = len({row["up3"] for row in bucket["rows"] if row["up3"]})
+        table.add([
+            number, project, total_up3, count, bucket["Belum Dikerjakan"],
+            bucket["Dalam Proses"], bucket["Selesai"], average / 100.0,
+            display_time(max(bucket["updates"]) if bucket["updates"] else ""),
+        ])
+    return table.finish()
+
