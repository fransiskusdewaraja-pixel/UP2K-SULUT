 TRUE_TEXTS = frozenset({"ya", "yes", "1", "true", "aktif", "y"})
 
 
+def anchor_construction_occurrences(
+        is_underbuild=False, has_jtm=False, has_jtr=False,
+        strict_existing=False, is_gardu=False):
+    """Kode konstruksi pada endpoint sumber lintas layer/status.
+
+    Tiang eksisting pada JTM selalu menjadi TM-4X. Jika bentang yang sama
+    membawa JTR underbuild, ujung bawah pada tiang eksisting adalah TR-3,
+    bukan TR-7 dan bukan dipindahkan ke tiang rencana tetangganya. Gardu tetap
+    menjadi sumber tarikan TR-7 sesuai aturan existing.
+    """
+    result = []
+    if bool(is_underbuild):
+        if bool(has_jtm) and bool(strict_existing):
+            result.append(("utama", "TM-4X"))
+        if bool(has_jtr):
+            if bool(strict_existing):
+                result.append(("underbuild", TERMINATION_CODE))
+            elif bool(is_gardu):
+                result.append(("underbuild", "TR-7"))
+        return result
+    if bool(has_jtm) and bool(strict_existing):
+        result.append(("utama", "TM-4X"))
+    elif bool(has_jtr) and (bool(strict_existing) or bool(is_gardu)):
+        result.append(("utama", "TR-7"))
+    return result
+
+
